// .oxfmtrc.json 1.1.0

// This Oxfmt configuration (shared between all matterbridge packages) is designed for a TypeScript project using ESM modules.
// Oxfmt respect .gitignore.
// Package specific directories and files that should be ignored are merged from the .oxfmtignore files in each package.
{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    "**/.cache/**",
    "**/.git/**",
    "apps/**",
    "**/build/**",
    "**/coverage/**",
    "**/dist/**",
    "**/node_modules/**",
    "**/out/**",
    "**/screenshots/**",
    "**/scripts/**",
    "**/temp/**",
    "**/tmp/**",
    "**/package-lock.json",
    "**/bun.lock"
  ],
  "printWidth": 180,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "quoteProps": "consistent",
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "arrowParens": "always",
  "requirePragma": false,
  "insertPragma": false,
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "embeddedLanguageFormatting": "auto",
  "singleAttributePerLine": false,
  "sortImports": {
    "groups": [
      "side_effect",
      { "newlinesBetween": true },
      "builtin",
      { "newlinesBetween": true },
      "external",
      { "newlinesBetween": true },
      ["internal", "subpath"],
      { "newlinesBetween": true },
      ["parent", "sibling", "index"],
      { "newlinesBetween": true },
      "style",
      { "newlinesBetween": true },
      "unknown"
    ]
  },
  "sortPackageJson": false
}
